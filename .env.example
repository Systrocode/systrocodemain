# Google Search Console Integration
# To get these credentials:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project or select existing one
# 3. Enable Google Search Console API
# 4. Create OAuth 2.0 credentials
# 5. Get refresh token using OAuth 2.0 playground

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# 3. Your verified website URL (systrocode.tech)
GSC_SITE_URL=https://systrocode.tech

# Optional: Set to 'true' to always use mock data for development
GSC_USE_MOCK_DATA=true
