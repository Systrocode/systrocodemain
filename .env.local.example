# ⚠️  SECURITY NOTICE - DO NOT COMMIT THIS FILE ⚠️
# This file contains sensitive credentials and should never be pushed to Git
# Copy this template and rename to .env.local, then add your actual credentials

# ===========================================================
# MONGODB CONFIGURATION - REQUIRED
# ===========================================================
# Get your MongoDB connection string from MongoDB Atlas:
# 1. Go to https://cloud.mongodb.com/
# 2. Create a cluster (free tier available)
# 3. Create a database user
# 4. Get connection string from "Connect" button
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/systrocode?retryWrites=true&w=majority&appName=AtlasCluster
DB_NAME=systrocode

# ===========================================================
# NEXT.JS CONFIGURATION
# ===========================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-key-here

# ===========================================================
# FORMSPREE CONFIGURATION (OPTIONAL)
# ===========================================================
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id

# ===========================================================
# GOOGLE SEARCH CONSOLE INTEGRATION - OPTIONAL
# ===========================================================
# Domain: systrocode.tech (replace with your domain)

# 1. OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_actual_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_actual_client_secret_here

# 2. Refresh Token (from OAuth 2.0 Playground)
GOOGLE_REFRESH_TOKEN=your_actual_refresh_token_here

# 3. Your verified website URL
GSC_SITE_URL=https://your-domain.com

# 4. Development Settings
GSC_USE_MOCK_DATA=true  # Set to 'false' for live data

# ===========================================================
# SETUP INSTRUCTIONS
# ===========================================================
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to version control
# 4. The .env.local file is already in .gitignore for security
