# Google Search Console Integration - REQUIRED CREDENTIALS
# ===========================================================

# 1. OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_actual_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_actual_client_secret_here

# 2. Refresh Token (from OAuth 2.0 Playground)
GOOGLE_REFRESH_TOKEN=your_actual_refresh_token_here

# 3. Your verified website URL (exactly as shown in Search Console)
GSC_SITE_URL=https://systrocode.tech

# 4. Development Settings
GSC_USE_MOCK_DATA=false  # Set to 'true' for development with fake data

# ===========================================================
# EXAMPLE VALUES (DO NOT USE THESE - REPLACE WITH YOUR ACTUAL VALUES)
# ===========================================================
# GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwxyz
# GOOGLE_REFRESH_TOKEN=1//04abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz
